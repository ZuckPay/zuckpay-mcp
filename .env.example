# ============================================================
# zuckpay-mcp — variáveis de ambiente
#
# ATENÇÃO: o servidor MCP NÃO carrega este arquivo automaticamente.
# As variáveis devem ser definidas no bloco "env" da configuração
# do seu cliente MCP (Claude Code, Claude Desktop, Cursor...).
# Este arquivo existe apenas como referência dos nomes esperados.
# NUNCA commite credenciais reais.
# ============================================================

# Credenciais de integração (painel ZuckPay > Desenvolvedores > Credenciais API)
ZUCKPAY_CLIENT_ID=
ZUCKPAY_CLIENT_SECRET=

# OBSOLETA desde 0.3.1: não habilita mais nada, apenas emite um aviso.
# A tool de saque foi removida do registro porque /v3/pix/withdraw exige o PIN
# do vendedor, e o PIN não pode trafegar pela conversa do assistente.
# Faça saques pelo painel ZuckPay.
# ZUCKPAY_ENABLE_WITHDRAW=true

# Opcional: sobrescreve a base da API (apenas https://).
# Padrão: https://www.zuckpay.com.br/conta
# ZUCKPAY_BASE_URL=

# ── Somente para o modo HTTP hospedado (dist/http.js) ──
# Porta do serviço (Railway injeta automaticamente)
# PORT=8080
# Atrás de proxy (Railway/Cloudflare): habilita leitura do X-Forwarded-For.
# Só ligue se HOUVER mesmo um proxy na frente — com isto ligado sem proxy, o
# cliente escolhe o próprio IP e o rate limit vira decoração.
# MCP_TRUST_PROXY=true
#
# Quantos proxies CONFIÁVEIS existem na frente (padrão 1).
# O IP real é lido do fim da cadeia X-Forwarded-For pra dentro: cada proxy
# anexa à direita o peer de quem recebeu, então tudo à esquerda do último hop
# é texto que o próprio cliente pôde escrever. Errar pra MAIS aqui volta a
# aceitar um hop forjado — na dúvida, deixe 1.
#   Railway/Cloudflare direto: 1     Cloudflare -> Railway: 2
# MCP_TRUST_PROXY_HOPS=1
#
# Rate limit por IP por minuto (padrão 60). O limite por credencial é 4x este
# valor, para um mesmo tenant chegando de vários IPs.
# ATENÇÃO: o contador é em memória e POR INSTÂNCIA. Com N réplicas no Railway
# o teto efetivo é N x este valor, e ele zera a cada deploy. Isto é proteção
# contra abuso de um cliente, NÃO contra DDoS volumétrico — para isso, borda
# (Cloudflare/WAF) na frente do serviço.
# MCP_RATE_LIMIT_PER_MINUTE=60
#
# Teto de conexões TCP simultâneas (padrão 512). O rate limit conta requests;
# sockets abertos que nunca completam um request não passam por ele.
# MCP_MAX_CONNECTIONS=512
